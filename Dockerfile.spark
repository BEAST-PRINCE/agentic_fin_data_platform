FROM apache/spark-py:v3.4.0

USER root

# Install PyTorch for CUDA 11.8 (Compatible with host NVIDIA driver 12.0.x)
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu118

# Install other required Python dependencies for the pipeline
RUN pip install --no-cache-dir python-dotenv minio numpy boto3 keybert sentence-transformers pandas pyarrow

# Switch back to default user if needed (Spark usually runs as a specific user or root depending on setup)
# In our docker-compose we specify user: root, so we can leave it as root here.
