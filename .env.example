# =============================================================================
# Agentic Data Lake - Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to '.env' and update the values to match your deployment setup.
# DO NOT commit real API keys, passwords, or tokens to version control.
# =============================================================================

# =============================================================================
# MinIO / Object Storage Configuration
# =============================================================================
# MinIO root admin username and password (used by MinIO container & PySpark S3 access)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your_minio_root_password_here

# MinIO service endpoint (Use localhost:9000 for local dev or minio:9000 inside Docker network)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_SECURE=false

# Bucket names for the Medallion Architecture data lake layers
MINIO_BRONZE_BUCKET=bronze
MINIO_SILVER_BUCKET=silver
MINIO_GOLD_BUCKET=gold

# =============================================================================
# Kafka Messaging System Configuration
# =============================================================================
# Kafka bootstrap brokers (comma-separated list, e.g., 127.0.0.1:9092 or kafka:9092)
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# Main topic for raw ingested news / financial data
KAFKA_TOPIC=raw_news
# RAW_DATA_PATH=data/raw_data_source/News Dataset.csv

# =============================================================================
# Agent & LLM Engine Configuration
# =============================================================================
# Execution mode for LLMs:
# - 'local': Runs local open-source models via Ollama (e.g. gemma:4b, llama3.2:3b)
# - 'api':   Uses cloud providers (Google Gemini, OpenAI, Anthropic, etc. via LiteLLM/ADK)
LLM_MODE=api

# Automatically start the AI Agent microservice on system startup (true/false)
START_AGENT_ON_BOOT=false

# Active LLM Model Identifier:
# - If LLM_MODE=local:  Use Ollama model name (e.g., 'gemma:4b', 'llama3.2:3b')
# - If LLM_MODE=api:    Use standard model string (e.g., 'gemini-1.5-flash', 'gemini-2.5-flash')
#                       For non-Google models, prefix provider (e.g., 'openai/gpt-4o', 'anthropic/claude-3-5-sonnet')
# AGENT_MODEL=gemini-3.5-flash
AGENT_MODEL=gemini-3.1-flash-lite
# AGENT_MODEL=openai/gpt-4o

# Cloud Provider API Keys (Required when LLM_MODE=api)
# Replace placeholders with your actual API keys in your local .env file
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# Vector Database & AI Embeddings Configuration
# =============================================================================
# Embedding Engine: 'sentence-transformers' (GPU/CPU local PyTorch) or 'fastembed' (Lightweight ONNX fallback)
# Note: 'fastembed' is recommended when running alongside Ollama for lower memory footprint.
VECTOR_EMBEDDING_ENGINE=sentence-transformers

# HuggingFace model identifier for vector embeddings (e.g., 'all-MiniLM-L6-v2')
VECTOR_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Dimensionality of the embedding model output vectors (must match VECTOR_EMBEDDING_MODEL spec)
VECTOR_EMBEDDING_DIMENSIONS=384

# =============================================================================
# Health Check Verification Flags
# =============================================================================
# Controls which dependent infrastructure components should be verified
# when the /api/health endpoint is called.
HEALTH_CHECK_ENABLE_MINIO=true
HEALTH_CHECK_ENABLE_KAFKA=true
HEALTH_CHECK_ENABLE_QDRANT=true
HEALTH_CHECK_ENABLE_DUCKDB=true
HEALTH_CHECK_ENABLE_OLLAMA=false

# =============================================================================
# External Services & Integrations
# =============================================================================
# HuggingFace User Access Token (Required for accessing gated models/datasets or higher API rate limits)
HF_TOKEN=your_huggingface_token_here